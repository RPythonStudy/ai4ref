# .env.example — 실제 값은 .env (gitignore)

# PubMed (NCBI E-utilities)
ENTREZ_EMAIL="your-email@example.com"
PUBMED_API_KEY="your-pubmed-api-key"   # 선택 — 있으면 rate limit 완화

# Zotero (write 권한 키 — zotero.org/settings/keys)
ZOTERO_API_KEY="your-zotero-api-key"
ZOTERO_USER_ID="your-zotero-user-id"

# Telegram (감시 알림 sink — 미설정 시 fail-soft skip)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"

# 수집 트랙 PDF 저장처 (기본값 data/pdf; 실제 = Gdrive Zotero_attachments)
AI4REF_PDF_DIR=/mnt/d/Gdrive/Zotero_attachments
